{
  "name": "simpleform",
  "version": "0.4.3",
  "description": "Signals-first micro-library for research dashboard controls. Real HTML, one store, no build step for consumers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/simpleform.d.ts",
      "import": "./dist/simpleform.js"
    },
    "./simpleform.css": "./simpleform.css"
  },
  "types": "./dist/simpleform.d.ts",
  "files": [
    "dist",
    "simpleform.css"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/simpleform.js && tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "python3 -m http.server 8137",
    "socket": "uv run --with fastapi --with uvicorn --with websockets examples/socket/server.py",
    "types:socket": "npx -y openapi-typescript http://localhost:8780/openapi.json -o examples/socket/api.d.ts"
  },
  "repository": "github:Zaffer/simpleform",
  "license": "MIT",
  "author": "James Wiles (https://github.com/Zaffer)",
  "sideEffects": false,
  "keywords": [
    "signals",
    "dashboard",
    "controls",
    "reactive",
    "no-build",
    "data-binding",
    "control-panel",
    "threejs",
    "alien-signals"
  ],
  "devDependencies": {
    "alien-signals": "3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
